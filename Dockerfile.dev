FROM node:20-bookworm-slim
WORKDIR /app
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce
ENV UPLOAD_DIR=/uploads
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
COPY prisma.config.ts tsconfig.json next.config.mjs eslint.config.mjs postcss.config.mjs next-env.d.ts ./
RUN npx prisma generate
EXPOSE 3000 5555
CMD ["npm", "run", "dev"]
