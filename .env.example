DATABASE_URL=
AUTH_SECRET=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=
APP_URL=
API_URL=
META_PIXEL_ID=
GTM_CONTAINER_ID=

# Set by scripts/deploy-cpanel.ps1 at build time; /api/version reports it so a
# deploy can tell which build a process is actually running.
NEXT_PUBLIC_RELEASE_COMMIT=
# Shared secret that lets a deploy tell a stale process to exit. Leave empty to
# disable /api/deploy/restart entirely. Must match the deploying machine's
# DEPLOY_RESTART_TOKEN.
DEPLOY_RESTART_TOKEN=

BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=
BKASH_CREATE_PAYMENT_PATH=
BKASH_EXECUTE_PAYMENT_PATH=
BKASH_QUERY_PAYMENT_PATH=
BKASH_WEBHOOK_SECRET=
