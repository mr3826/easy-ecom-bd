DATABASE_URL=
AUTH_SECRET=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=
APP_URL=
UPLOAD_DIR=

# All four SMTP values must be set or sendEmail returns "SMTP not configured"
# and callers only log it, so a broken configuration is invisible from outside.
# SMTP_HOST must be a name the mail server's certificate actually covers: port
# 465 is implicit TLS and is verified before the password is sent, so localhost
# fails validation. FROM_EMAIL must equal SMTP_USER or Exim rejects the sender.
# See docs/OPERATIONS.md for the production values.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=

# Set by scripts/deploy-cpanel.ps1 at build time; /api/version reports it so a
# deploy can tell which build a process is actually running.
NEXT_PUBLIC_RELEASE_COMMIT=
# Shared secret that lets a deploy tell a stale process to exit. Leave empty to
# disable /api/deploy/restart entirely. Must match the deploying machine's
# DEPLOY_RESTART_TOKEN.
DEPLOY_RESTART_TOKEN=

BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_BASE_URL=
BKASH_CREATE_PAYMENT_PATH=
BKASH_EXECUTE_PAYMENT_PATH=
BKASH_QUERY_PAYMENT_PATH=
BKASH_WEBHOOK_SECRET=
